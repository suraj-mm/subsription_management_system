# Application Security
SECRET_KEY=dev-secret-key-brightloop-change-in-production-12345

# Database URL (SQLite default for zero-setup local evaluation, PostgreSQL ready)
DATABASE_URL=sqlite:///./brightloop.db

# Frontend URL for CORS & Reset Links
FRONTEND_URL=http://localhost:5173
DEBUG=True

# Email / SMTP Settings (Optional, console fallback enabled if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Seed Admin Credentials (Initial setup)
ADMIN_EMAIL=admin@brightloop.com
ADMIN_PASSWORD=Admin@12345
